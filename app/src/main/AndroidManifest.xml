<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Red: llamada al API. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Bluetooth: impresora ESC/POS. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Mantener pantalla encendida mientras el POS esta activo. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Camara: escaneo de QR en modo Garzon (sprint 3.2). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <queries>
        <!-- Bluetooth: listar dispositivos emparejados. -->
        <intent>
            <action android:name="android.bluetooth.devicepicker.action.LAUNCH" />
        </intent>
    </queries>

    <application
        android:name=".CsaePosApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CsaePos"
        android:usesCleartextTraffic="false"
        android:extractNativeLibs="false"
        tools:targetApi="33">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.CsaePos"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Sprint 3.2.1: FileProvider para que el operador pueda abrir los
             PDFs generados como fallback de impresion (TicketScreen). El path
             del cache y el directorio publico Downloads estan en file_paths.xml. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Sprint F7 (2026-08-11): al pasar a play-services-mlkit-barcode-scanning
             (unbundled), el modelo de barcode se descarga desde Google Play Services
             en vez de venir embebido. Este meta-data hace que Play Store descargue
             el modelo automaticamente al instalar la app, evitando que la primera
             lectura tarde unos segundos. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode" />

        <!-- F4 (2026-08-13): SDK de la impresora POS PPT305BT (vendor
             net.posprinter). Expone un AIDL Service (PosprinterService) que
             se bindea desde PrinterService.kt. El JAR esta en app/libs/
             (ignorado en git, ver .gitignore). El service ya viene
             compilado en el JAR, solo necesitamos declararlo aca para que
             Android lo instancie. El binding se hace en PrinterService via
             Context.bindService(intent, conn, BIND_AUTO_CREATE). -->
        <service
            android:name="net.posprinter.service.PosprinterService"
            android:exported="false" />
    </application>

</manifest>
